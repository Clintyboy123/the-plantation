# Copy this file to .env and fill it in:   cp .env.example .env
# .env holds real passwords and must never be committed or shared.
# Generate each password/secret with:      openssl rand -base64 32

# --- Application -------------------------------------------------------------
NODE_ENV=production
APP_NAME="The Plantation"

# Unique per website. Names this site's containers, network and database volume.
COMPOSE_PROJECT_NAME=theplantation

# --- Ports -------------------------------------------------------------------
# The port the VPS-level Nginx forwards this domain to. Must be unique per website on the VPS.
# 8103 is an assumption (8101 portfolio, 8102 Fireside) - confirm before deploying.
FRONTEND_PORT=8103

# Internal only (never public). If you change it, change it in frontend/nginx/default.conf too.
BACKEND_PORT=3000

# How many proxies sit in front of the API: 2 on the VPS (VPS Nginx + frontend Nginx).
TRUST_PROXY=2

# --- Database ----------------------------------------------------------------
MYSQL_DATABASE=theplantation
MYSQL_USER=theplantation
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too

DB_HOST=database
DB_PORT=3306

# --- Enquiry email (optional) -------------------------------------------------
# Every enquiry is saved to the database first. If SMTP_HOST is empty, nothing is emailed
# (enquiries are read with the command in README.md). Fill these in to get an email per enquiry.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="The Plantation website <no-reply@theplantation.co.za>"
# Where enquiries go. The Boma and 39 on Church have their own inboxes; leave either empty to send to MAIL_TO.
MAIL_TO=bookings@theplantation.co.za
MAIL_TO_BOMA=theboma@rmproperties.co.za
MAIL_TO_CHURCH=

# --- Deployment (set on the VPS by deploy/deploy.sh; leave unset on your computer) ---
# FRONTEND_IMAGE=
# BACKEND_IMAGE=
